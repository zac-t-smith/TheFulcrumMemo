# ============================================================
# Browser build-time env (Vite inlines these — safe to ship)
# ============================================================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
# Note: there is no VITE_OPS_PIN. The /#/falcon console gate verifies
# a per-session PIN server-side via falcon.verify_ops_secret.

# ============================================================
# Local-only — never ship these to the browser
# Used by scripts/simulate-class.ts
# ============================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...
